# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# Get a token from https://t.me/BotFather
# ---------------------------------------------------------------------------

# REQUIRED — your bot token from BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# OPTIONAL — allow anyone to use the bot. Leave empty to only allow this user.
ALLOWED_USER_ID=

# OPTIONAL — max file size to send straight to chat (MB). 0 = unlimited.
MAX_UPLOAD_MB=50

# OPTIONAL — temp/download directory (created if missing)
DOWNLOAD_DIR=./downloads

# OPTIONAL — yt-dlp workers / retries
YTDLP_RETRIES=10
YTDLP_CONCURRENT=4

# OPTIONAL — log level: INFO, DEBUG, WARNING, ERROR
LOG_LEVEL=INFO
